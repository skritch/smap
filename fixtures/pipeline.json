{
  "startFocus": "pipeline",
  "boxes": {
    "pipeline":  { "label": "Quake segmentation", "summary": "Nightly batch DAG from raw seismic waveforms to a catalog of segmented events", "side": "in",
                   "axes": { "left": "upstream: sources", "right": "downstream: outputs", "up": "alerting", "down": "ad-hoc reads" },
                   "sources": ["pipeline/"], "children": ["ingest", "preprocess", "detect", "segment", "publish", "config"] },

    "waveforms": { "label": "Waveform archive", "external": true, "summary": "Continuous miniSEED, one object per station per day", "side": "left",  "sources": [], "children": [] },
    "registry":  { "label": "Station registry", "external": true, "summary": "Station locations and instrument responses", "side": "left",  "sources": [], "children": [] },
    "catalog":   { "label": "Event catalog", "external": true,    "summary": "Published events the hazard maps read from", "side": "right", "sources": [], "children": [] },
    "alerts":    { "label": "Slack alerts", "external": true, "ambient": true, "summary": "Gap, clipping and freshness checks post here", "side": "up", "sources": ["pipeline/alerts.py"], "children": [] },
    "config":    { "label": "Config", "ambient": true, "summary": "Dates, filter bands, trigger thresholds", "side": "in", "sources": ["config/pipeline.yaml", "pipeline/settings.py"], "children": [] },
    "analysis":  { "label": "Analysis notebooks", "summary": "Ad-hoc exploration of intermediate tables", "side": "down",
                   "sources": ["notebooks/"], "children": ["nb_picks", "nb_classifier"] },

    "ingest":     { "label": "Ingest",     "summary": "Pull raw waveforms and station metadata locally", "side": "in", "sources": ["pipeline/ingest/"],
                    "children": ["fetch_waveforms", "fetch_stations", "fetch_responses"] },
    "preprocess": { "label": "Preprocess", "summary": "Filter traces, reconcile station metadata", "side": "in", "sources": ["pipeline/preprocess/"],
                    "children": ["filter_waveforms", "dedupe_stations"] },
    "detect":     { "label": "Detect",     "summary": "Pick phase arrivals and group them into candidate events", "side": "in", "sources": ["pipeline/detect/"],
                    "children": ["pick_phases", "associate_picks"] },
    "segment":    { "label": "Segment",    "summary": "Classify candidates and bound each event in time", "side": "in", "sources": ["pipeline/segment/"],
                    "children": ["train_classifier", "segment_events"] },
    "publish":    { "label": "Publish",    "summary": "Write events to the catalog", "side": "in", "sources": ["pipeline/publish/"],
                    "children": ["export_catalog"] },

    "fetch_waveforms":  { "label": "fetch_waveforms.py",  "summary": "Copy yesterday's traces from the archive",        "side": "in", "sources": ["pipeline/ingest/fetch_waveforms.py"],     "children": [] },
    "fetch_stations":   { "label": "fetch_stations.py",   "summary": "Incremental pull of station epochs",              "side": "in", "sources": ["pipeline/ingest/fetch_stations.py"],      "children": [] },
    "fetch_responses":  { "label": "fetch_responses.py",  "summary": "Full snapshot of instrument responses",           "side": "in", "sources": ["pipeline/ingest/fetch_responses.py"],     "children": [] },
    "filter_waveforms": { "label": "filter_waveforms.py", "summary": "Detrend, bandpass, mask gaps and clipping",       "side": "in", "sources": ["pipeline/preprocess/filter_waveforms.py"], "children": [] },
    "dedupe_stations":  { "label": "dedupe_stations.py",  "summary": "Collapse overlapping channel epochs",             "side": "in", "sources": ["pipeline/preprocess/dedupe_stations.py"],  "children": [] },
    "pick_phases":      { "label": "pick_phases.py",      "summary": "STA/LTA triggers, then P and S picks",            "side": "in", "sources": ["pipeline/detect/pick_phases.py"],          "children": [] },
    "associate_picks":  { "label": "associate_picks.py",  "summary": "Group picks across stations into candidate events", "side": "in", "sources": ["pipeline/detect/associate_picks.py"],    "children": [] },
    "train_classifier": { "label": "train_classifier.py", "summary": "Weekly retrain of the quake / blast / noise classifier", "side": "in", "sources": ["pipeline/segment/train_classifier.py"], "children": [] },
    "segment_events":   { "label": "segment_events.py",   "summary": "Label each candidate and find its onset and coda", "side": "in", "sources": ["pipeline/segment/segment_events.py"],    "children": [] },
    "export_catalog":   { "label": "export_catalog.py",   "summary": "Upsert events into the catalog",                  "side": "in", "sources": ["pipeline/publish/export_catalog.py"],     "children": [] },

    "nb_picks":       { "label": "explore_picks.ipynb",   "summary": "Pick residuals by station",                "side": "in", "sources": ["notebooks/explore_picks.ipynb"],   "children": [] },
    "nb_classifier":  { "label": "classifier_eval.ipynb", "summary": "Confusion matrix and feature importance", "side": "in", "sources": ["notebooks/classifier_eval.ipynb"], "children": [] }
  },
  "edges": [
    { "id": "p1",  "from": "waveforms",        "to": "fetch_waveforms" },
    { "id": "p2",  "from": "registry",         "to": "fetch_stations" },
    { "id": "p3",  "from": "registry",         "to": "fetch_responses" },
    { "id": "p4",  "from": "fetch_waveforms",  "to": "filter_waveforms", "label": "raw.mseed" },
    { "id": "p5",  "from": "fetch_stations",   "to": "dedupe_stations",  "label": "epochs_raw.parquet" },
    { "id": "p6",  "from": "filter_waveforms", "to": "pick_phases",      "label": "filtered.mseed" },
    { "id": "p7",  "from": "fetch_responses",  "to": "pick_phases",      "label": "responses.xml" },
    { "id": "p8",  "from": "pick_phases",      "to": "associate_picks",  "label": "picks.parquet" },
    { "id": "p9",  "from": "dedupe_stations",  "to": "associate_picks",  "label": "stations.parquet" },
    { "id": "p10", "from": "associate_picks",  "to": "train_classifier", "label": "candidates.parquet" },
    { "id": "p11", "from": "associate_picks",  "to": "segment_events",   "label": "candidates.parquet" },
    { "id": "p12", "from": "train_classifier", "to": "segment_events",   "label": "classifier.pkl" },
    { "id": "p13", "from": "segment_events",   "to": "export_catalog",   "label": "events.parquet" },
    { "id": "p14", "from": "export_catalog",   "to": "catalog",          "label": "events" },
    { "id": "p15", "from": "pick_phases",      "to": "nb_picks",         "label": "picks.parquet" },
    { "id": "p16", "from": "train_classifier", "to": "nb_classifier",    "label": "classifier.pkl" },
    { "id": "p17", "from": "associate_picks",  "to": "nb_classifier",    "label": "candidates.parquet" },
    { "id": "p18", "from": "config",           "to": "fetch_waveforms" },
    { "id": "p19", "from": "config",           "to": "fetch_stations" },
    { "id": "p20", "from": "config",           "to": "train_classifier" },
    { "id": "p21", "from": "config",           "to": "export_catalog" },
    { "id": "p22", "from": "fetch_waveforms",  "to": "alerts" },
    { "id": "p23", "from": "filter_waveforms", "to": "alerts" },
    { "id": "p24", "from": "dedupe_stations",  "to": "alerts" },
    { "id": "p25", "from": "segment_events",   "to": "alerts" },
    { "id": "p26", "from": "export_catalog",   "to": "alerts" }
  ]
}
