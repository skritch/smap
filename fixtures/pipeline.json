{
  "root": "pipeline",
  "boxes": {
    "pipeline":  { "label": "Churn pipeline", "summary": "Nightly batch DAG from raw events to churn scores", "side": "in",
                   "axes": "left → right = dataflow, up = alerting, down = config and ad-hoc reads",
                   "sources": ["pipeline/"], "children": ["ingest", "clean", "transform", "model", "publish"] },

    "s3_raw":    { "label": "S3 raw events",   "summary": "Clickstream dumps, one prefix per day", "side": "left",  "sources": [], "children": [] },
    "orders_db": { "label": "Orders DB",       "summary": "Read replica of the production Postgres", "side": "left",  "sources": [], "children": [] },
    "warehouse": { "label": "Warehouse",       "summary": "Snowflake schema the dashboards read from", "side": "right", "sources": [], "children": [] },
    "alerts":    { "label": "Slack alerts",    "summary": "Row-count and freshness checks post here", "side": "up",    "sources": ["pipeline/alerts.py"], "children": [] },
    "config":    { "label": "Config",          "summary": "Dates, paths, model params", "side": "down",  "sources": ["config/pipeline.yaml", "pipeline/settings.py"], "children": [] },
    "analysis":  { "label": "Analysis notebooks", "summary": "Ad-hoc exploration of intermediate tables", "side": "down",
                   "sources": ["notebooks/"], "children": ["nb_sessions", "nb_model"] },

    "ingest":    { "label": "Ingest",    "summary": "Pull raw data to local parquet", "side": "in", "sources": ["pipeline/ingest/"],
                   "children": ["fetch_events", "fetch_orders", "fetch_users"] },
    "clean":     { "label": "Clean",     "summary": "Validate, dedupe, normalize", "side": "in", "sources": ["pipeline/clean/"],
                   "children": ["clean_events", "dedupe_orders"] },
    "transform": { "label": "Transform", "summary": "Sessionize and build features", "side": "in", "sources": ["pipeline/transform/"],
                   "children": ["join_sessions", "build_features"] },
    "model":     { "label": "Model",     "summary": "Train and score the churn model", "side": "in", "sources": ["pipeline/model/"],
                   "children": ["train_churn", "score_users"] },
    "publish":   { "label": "Publish",   "summary": "Write results to the warehouse", "side": "in", "sources": ["pipeline/publish/"],
                   "children": ["export_scores"] },

    "fetch_events":   { "label": "fetch_events.py",   "summary": "Copy yesterday's clickstream from S3", "side": "in", "sources": ["pipeline/ingest/fetch_events.py"],   "children": [] },
    "fetch_orders":   { "label": "fetch_orders.py",   "summary": "Incremental pull of orders",            "side": "in", "sources": ["pipeline/ingest/fetch_orders.py"],   "children": [] },
    "fetch_users":    { "label": "fetch_users.py",    "summary": "Full snapshot of users table",          "side": "in", "sources": ["pipeline/ingest/fetch_users.py"],    "children": [] },
    "clean_events":   { "label": "clean_events.py",   "summary": "Drop bots, fix timestamps",             "side": "in", "sources": ["pipeline/clean/clean_events.py"],    "children": [] },
    "dedupe_orders":  { "label": "dedupe_orders.py",  "summary": "Collapse retried order writes",         "side": "in", "sources": ["pipeline/clean/dedupe_orders.py"],   "children": [] },
    "join_sessions":  { "label": "join_sessions.py",  "summary": "Sessionize events, attach users",       "side": "in", "sources": ["pipeline/transform/join_sessions.py"], "children": [] },
    "build_features": { "label": "build_features.py", "summary": "Per-user rolling aggregates",           "side": "in", "sources": ["pipeline/transform/build_features.py"], "children": [] },
    "train_churn":    { "label": "train_churn.py",    "summary": "Weekly retrain of gradient-boosted model", "side": "in", "sources": ["pipeline/model/train_churn.py"],   "children": [] },
    "score_users":    { "label": "score_users.py",    "summary": "Apply latest model to all users",       "side": "in", "sources": ["pipeline/model/score_users.py"],     "children": [] },
    "export_scores":  { "label": "export_scores.py",  "summary": "Upsert scores into the warehouse",       "side": "in", "sources": ["pipeline/publish/export_scores.py"], "children": [] },

    "nb_sessions":    { "label": "explore_sessions.ipynb", "summary": "Session length distributions", "side": "in", "sources": ["notebooks/explore_sessions.ipynb"], "children": [] },
    "nb_model":       { "label": "model_eval.ipynb",       "summary": "Calibration and feature importance", "side": "in", "sources": ["notebooks/model_eval.ipynb"], "children": [] }
  },
  "edges": [
    { "id": "p1",  "from": "s3_raw",         "to": "fetch_events" },
    { "id": "p2",  "from": "orders_db",      "to": "fetch_orders" },
    { "id": "p3",  "from": "orders_db",      "to": "fetch_users" },
    { "id": "p4",  "from": "fetch_events",   "to": "clean_events",   "label": "events_raw.parquet" },
    { "id": "p5",  "from": "fetch_orders",   "to": "dedupe_orders",  "label": "orders_raw.parquet" },
    { "id": "p6",  "from": "clean_events",   "to": "join_sessions",  "label": "events.parquet" },
    { "id": "p7",  "from": "fetch_users",    "to": "join_sessions",  "label": "users.parquet" },
    { "id": "p8",  "from": "join_sessions",  "to": "build_features", "label": "sessions.parquet" },
    { "id": "p9",  "from": "dedupe_orders",  "to": "build_features", "label": "orders.parquet" },
    { "id": "p10", "from": "build_features", "to": "train_churn",    "label": "features.parquet" },
    { "id": "p11", "from": "build_features", "to": "score_users",    "label": "features.parquet" },
    { "id": "p12", "from": "train_churn",    "to": "score_users",    "label": "model.pkl" },
    { "id": "p13", "from": "score_users",    "to": "export_scores",  "label": "scores.parquet" },
    { "id": "p14", "from": "export_scores",  "to": "warehouse",      "label": "churn_scores" },
    { "id": "p15", "from": "join_sessions",  "to": "nb_sessions",    "label": "sessions.parquet" },
    { "id": "p16", "from": "train_churn",    "to": "nb_model",       "label": "model.pkl" },
    { "id": "p17", "from": "build_features", "to": "nb_model",       "label": "features.parquet" },
    { "id": "p18", "from": "config",         "to": "pipeline" },
    { "id": "p19", "from": "pipeline",       "to": "alerts",         "label": "check failures" }
  ]
}
